# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID or group chat ID (optional; can be auto-detected by bot)
VITE_TELEGRAM_CHAT_ID=your_chat_id_here

# Meta (Facebook) Pixel ID for Ads Tracking & Optimization
# Get your Pixel / Dataset ID from Meta Events Manager (e.g. 1234567890123456)
VITE_FB_PIXEL_ID=
