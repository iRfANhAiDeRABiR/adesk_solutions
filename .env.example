# =========================================================================
# Server-Side Private Environment Variables (Vercel Project Settings)
# WARNING: NEVER prefix server secrets with VITE_ to prevent bundling into client JavaScript!
# =========================================================================

# Telegram Bot Token from @BotFather (Private Server-Side Only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Administrator Telegram Chat ID for order notifications
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# Allowed Telegram User IDs permitted to confirm/reject orders via inline buttons (comma-separated)
ALLOWED_ADMIN_IDS=your_telegram_user_id_here

# Secret token configured for Telegram Webhook (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Meta Conversions API (CAPI) Server-Side Credentials (Private - NEVER expose to frontend)
META_PIXEL_ID=YOUR_META_DATASET_ID
META_CAPI_ACCESS_TOKEN=SET_PRIVATELY_IN_VERCEL
META_GRAPH_API_VERSION=v21.0

# Optional: Meta Test Event Code for staging/testing in Meta Events Manager Test Events tab
# META_TEST_EVENT_CODE=TEST12345

# =========================================================================
# Client-Side Public Environment Variables (Vite Frontend Build)
# =========================================================================

# Meta (Facebook) Pixel / Dataset ID (public client identifier)
VITE_FB_PIXEL_ID=YOUR_META_DATASET_ID
